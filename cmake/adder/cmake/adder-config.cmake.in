@PACKAGE_INIT@

include(FeatureSummary)
include("${CMAKE_CURRENT_LIST_DIR}/adder-extra.cmake")

if(BUILD_SHARED_LIBS)
    include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-shared.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-static.cmake" OPTIONAL)

    add_library(adder::adder ALIAS adder::adder_shared)
else()
    include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-shared.cmake" OPTIONAL)
    include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-static.cmake")

    add_library(adder::adder ALIAS adder::adder_static)
endif()

check_required_components(adder)

set_package_properties(adder
    PROPERTIES
        URL "@PROJECT_HOMEPAGE_URL@"
        DESCRIPTION "@PROJECT_DESCRIPTION@"
)
