@PACKAGE_INIT@

include(FeatureSummary)
set_package_properties(adder
    PROPERTIES
        URL "@PROJECT_HOMEPAGE_URL@"
        DESCRIPTION "@PROJECT_DESCRIPTION@"
)

if(BUILD_SHARED_LIBS)
    include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-shared.cmake" OPTIONAL RESULT_VARIABLE shared_targets)
    if (NOT shared_targets)
        include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-static.cmake" OPTIONAL RESULT_VARIABLE static_targets)
    endif()
else()
    include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-static.cmake" OPTIONAL RESULT_VARIABLE static_targets)
    if (NOT static_targets)
        include("${CMAKE_CURRENT_LIST_DIR}/adder-targets-shared.cmake" OPTIONAL RESULT_VARIABLE shared_targets)
    endif()
endif()

if (NOT shared_targets AND NOT static_targets)
    set(adder_FOUND FALSE)
endif()

check_required_components(adder)

include("${CMAKE_CURRENT_LIST_DIR}/adder-extra.cmake")
