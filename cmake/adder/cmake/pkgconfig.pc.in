prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
bindir=@CMAKE_INSTALL_FULL_BINDIR@
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: @PROJECT_NAME@
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@

Libs: -L${libdir} -l$<TARGET_LINKER_FILE_NAME:$<TARGET_PROPERTY:NAME>>
Cflags: -I${includedir}$<LIST:TRANSFORM,$<TARGET_PROPERTY:PUBLIC_COMPILE_DEFINITIONS>,PREPEND, -D>$<LIST:TRANSFORM,$<TARGET_PROPERTY:INTERFACE_COMPILE_DEFINITIONS>,PREPEND, -D>
